# 确保所有 SQL 迁移文件使用 LF 换行符
backend/migrations/*.sql text eol=lf

# Go 源代码文件
*.go text eol=lf

# 前端 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# Shell 脚本
*.sh text eol=lf

# YAML/YML 配置文件
*.yaml text eol=lf
*.yml text eol=lf

# Dockerfile
Dockerfile text eol=lf

# auto generated by UGit 
*.exe filter=lfs diff=lfs merge=binary -text
*.exe~ filter=lfs diff=lfs merge=binary -text
*.gif filter=lfs diff=lfs merge=binary -text
*.png filter=lfs diff=lfs merge=binary -text
*.ttf filter=lfs diff=lfs merge=binary -text
*.woff filter=lfs diff=lfs merge=binary -text
*.jpg filter=lfs diff=lfs merge=binary -text
*.otf filter=lfs diff=lfs merge=binary -text
*.gz filter=lfs diff=lfs merge=binary -text
*.mod filter=lfs diff=lfs merge=binary -text
go.mod !filter=lfs !diff=lfs !merge=binary -text
curl filter=lfs diff=lfs merge=binary -text

